+class CountingTokenizer(MockTokenizer):
+    def __init__(self, inner: Any) -> None:
+        self.inner = inner
+
+    def encode(self, text: str) -> List[int]:
+        _COUNTING["encode"] += 1
+        return self.inner.encode(text)
+
+    def decode(self, ids: List[int]) -> str:
+        return self.inner.decode(ids)
